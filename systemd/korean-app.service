[Unit]
Description=Korean Learning App (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/korean-app
EnvironmentFile=/home/ubuntu/korean-app/.env
ExecStart=/home/ubuntu/korean-app/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8016 \
    --workers 2 \
    --log-level info
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=korean-app

# Security hardening
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/korean-app

[Install]
WantedBy=multi-user.target
